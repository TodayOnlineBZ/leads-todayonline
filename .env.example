# De Supabase-integratie van Vercel zet deze waarden automatisch.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alleen op de server; nooit met NEXT_PUBLIC_ beginnen.
SUPABASE_SECRET_KEY=

# Zelf toevoegen in Vercel: de openbare sitekey van Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Zelf toevoegen in Vercel, alleen op de server: voor de meldingsmails via Resend.
RESEND_API_KEY=
